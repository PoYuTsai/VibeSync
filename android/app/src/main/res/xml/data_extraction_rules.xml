<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 備份與裝置間轉移規則（fail-closed：雲端備份與 D2D 轉移
     都全部排除）。主閘是 manifest 的 allowBackup=false，此檔防未來誤開
     時仍不外洩 token、加密 Hive、聊天與圖片。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

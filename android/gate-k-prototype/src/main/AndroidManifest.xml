<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gate K candidate A only: full MediaStore image access is measured as a
         policy-sensitive experiment, never silently downgraded to partial
         photo access. The selected-photos permission is declared solely to
         detect and reject that partial state. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:allowBackup="false"
        android:label="VibeSync Gate K Prototype"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <service
            android:name=".GateKPrototypeInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/gate_k_input_method" />
        </service>
    </application>
</manifest>
